# Required
DATABASE_URL="postgresql://jobapplier:jobapplier@localhost:5432/jobapplier"
OPENAI_API_KEY=""
RAPIDAPI_KEY=""

# Optional
OPENAI_MODEL="gpt-4o"            # check OpenAI's current model list
LOCAL_USER_EMAIL="me@localhost"  # identity used in single-user mode
SINGLE_USER_MODE="false"         # must be "true" for `npm start` (no login is built in)

# Optional: enables the applier service (services/applier). Generate with: openssl rand -hex 32
WORKER_TOKEN=""

# Optional: store CVs in S3 instead of ./storage
CV_BUCKET=""
AWS_REGION=""
