# Must match the Next.js app
APP_URL="http://localhost:3000"
WORKER_TOKEN=""                      # same value as WORKER_TOKEN in the app's .env (32+ characters)

# Behaviour
APPLIER_AUTO_SUBMIT="false"          # "true" submits when every required field is filled and there's no CAPTCHA
APPLIER_HEADLESS="false"             # only allowed with auto-submit; review mode needs a visible browser
APPLIER_REVIEW_MINUTES="15"          # how long to wait for you to submit before giving up
APPLIER_POLL_SECONDS="30"            # how often to check the queue when it's empty
APPLIER_PROFILE_DIR=".browser-profile"
APPLIER_ARTIFACTS_DIR="artifacts"    # screenshots of filled forms
